{
  "extends": ["config:recommended"],
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "prHourlyLimit": 0,
  "branchPrefix": "renovate/",
  "baseBranches": ["chart/rest-json-quickstart", "/^app\\/.*/"],
  "enabledManagers": ["helmv3", "maven"],
  "packageRules": [
    {
      "matchBaseBranches": ["chart/rest-json-quickstart"],
      "matchManagers": ["helmv3"],
      "enabled": true
    },
    {
      "matchBaseBranches": ["/^app\\/.*/"],
      "matchManagers": ["maven"],
      "enabled": true
    }
  ]
}
