{
  "extends": ["config:recommended"],
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "prHourlyLimit": 0,
  "branchPrefix": "renovate/",
  "packageRules": [
    {
      "matchBaseBranches": ["chart/rest-json-quickstart"],
      "enabledManagers": ["helmv3"]
    },
    {
      "matchBaseBranches": ["/^app\\/.*/"],
      "enabledManagers": ["helmv3"]
    }
  ]
}
